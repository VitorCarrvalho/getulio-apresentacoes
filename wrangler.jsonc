// Configuração do projeto Cloudflare Pages. Faz o Cloudflare publicar só a pasta publicar/,
// mesmo que o painel esteja com outra pasta. A pasta functions/ (token) é detectada sozinha.
{
  "name": "getulio-apresentacoes",
  "pages_build_output_dir": "./publicar",
  "compatibility_date": "2026-11-01"
}
